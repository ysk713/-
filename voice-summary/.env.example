# Claude API キー（https://platform.claude.com で発行）
ANTHROPIC_API_KEY=

# ブラウザで開くときのユーザー名とパスワード（setup_mac.sh が自動生成します）
APP_USER=doctor
APP_PASSWORD=

# 任意設定
CLAUDE_MODEL=claude-opus-5-5
WHISPER_MODEL=large-v3-turbo
MAX_UPLOAD_MB=500
PORT=8000

# ログイン失敗の制限（10分間にこの回数失敗すると、LOGIN_LOCK_MIN 分ログインできなくなる）
LOGIN_FAIL_LIMIT=10
LOGIN_LOCK_MIN=15
