{
  "_comment": "収集元の設定。URLが変わった・増やしたい場合はここを編集する。取得に失敗した収集元はスキップされ、ログに記録される。",
  "retention_days": 14,
  "max_news_per_country": 100,
  "max_videos_per_country": 8,
  "video_retention_days": 60,
  "request_interval_sec": 0.7,

  "per_country_news": {
    "_comment": "国ごとに Google ニュース RSS を検索する。{name} に国名が入る。英語は国内ツアーで都市名・州名を拾えるよう多めに残す。",
    "enabled": true,
    "queries": [
      {
        "lang": "ja",
        "q": "\"{name}\" (感染症 OR 医療 OR 病院 OR 保健 OR ワクチン OR 流行 OR 衛生) when:7d",
        "params": "hl=ja&gl=JP&ceid=JP:ja",
        "max_items": 30
      },
      {
        "lang": "en",
        "q": "\"{name}\" (outbreak OR epidemic OR hospital OR \"health ministry\" OR vaccine OR disease) when:7d",
        "params": "hl=en-US&gl=US&ceid=US:en",
        "max_items": 60
      }
    ]
  },

  "general_news": {
    "_comment": "医療以外のニュース（外交・政治・経済・文化・社会・スポーツ）。国ごとに国名だけで検索し、見出しのキーワードで種類に分ける。どの種類にも当てはまらない記事は使わない。キーワードは英語は単語単位・大文字小文字を区別しない、日本語は部分一致。",
    "enabled": true,
    "retention_days": 7,
    "max_items_per_country": 60,
    "queries": [
      {"lang": "ja", "q": "\"{name}\" when:3d", "params": "hl=ja&gl=JP&ceid=JP:ja", "max_items": 30},
      {"lang": "en", "q": "\"{name}\" when:3d", "params": "hl=en-US&gl=US&ceid=US:en", "max_items": 30}
    ],
    "categories": {
