  ],

  "video_channels": [
    {"_comment": "YouTube チャンネルの RSS（APIキー不要）。タイトルに国名があればその国に、なければ「世界全体」に表示。"},
    {"name": "World Health Organization (WHO)", "channel_id": "UC07-dOwgza1IguKA86jqxNA"}
  ],

  "translation": {
    "_comment": "環境変数 ANTHROPIC_API_KEY がある場合のみ、日本語以外の見出し（ニュース・動画タイトル）を日本語に訳す。新しい見出しだけを訳す。",
    "model": "claude-opus-5-5",
    "effort": "low",
    "batch_size": 80
  },

  "youtube_search": {
    "_comment": "環境変数 YOUTUBE_API_KEY がある場合のみ、国ごとに動画検索する。検索1回=100ユニット、無料枠は1日10,000ユニットなので1日あたり最大90か国程度を検索する（記事の多い上位30か国は毎日、残りは未検索・古い順に巡回）。",
    "daily_country_limit": 90,
    "daily_hot_countries": 30,
    "q": "{name} health OR hospital OR outbreak OR medical",
    "published_within_days": 30,
    "max_results": 4,
    "global_queries": ["WHO health emergency", "outbreak news", "感染症 ニュース"]
  }
}
